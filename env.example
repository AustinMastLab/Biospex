# Copy to .env for local development.
# On the servers, .env is generated from AWS SSM (/biospex/production and /biospex/development) by
# the deploy's env:ssm task, so add new settings there as well. Keys marked "local only" aren't in SSM.

# App
APP_NAME=Biospex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://biospex.test
APP_DOMAIN=biospex.test
APP_TAG=biospex
APP_SERVER_USER=ubuntu
APP_REGISTRATION=true

# API (devapi.biospex.org / api.biospex.org)
API_DOMAIN=api.biospex.test
# API_RATE_LIMIT=300

# Logging and alerts
LOG_CHANNEL=stack
# LOG_DAILY_DAYS=14
DB_LOG=false
ERROR_ALERTS_ENABLED=false
ERROR_ALERTS_TO=
# Healthchecks.io ping URL; production only
HEALTH_CHECK_PING_URL=

# MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=biospex
DB_USERNAME=root
DB_PASSWORD=

# MongoDB
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=biospex
# Local only; the servers' MongoDB has no authentication
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Redis, cache, sessions and queues
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# Local only; the servers use the config defaults (redis cache, memcached sessions)
CACHE_DRIVER=redis
SESSION_DRIVER=file
SESSION_DOMAIN=.biospex.test
# beanstalkd on the servers; sync runs jobs inline
QUEUE_CONNECTION=sync
RESPONSE_CACHE_ENABLED=false
RESPONSE_CACHE_DRIVER=file
RESPONSE_CACHE_LIFETIME=604800

# Broadcasting (Reverb)
BROADCAST_DRIVER=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=biospex.test
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_DEBUG=0
# Built into the JavaScript by Laravel Mix; CI sets them from the PROD_* and DEV_* repository variables
MIX_REVERB_APP_KEY="${REVERB_APP_KEY}"
MIX_REVERB_HOST="${REVERB_HOST}"
MIX_REVERB_PORT="${REVERB_PORT}"
MIX_REVERB_SCHEME="${REVERB_SCHEME}"

# Mail
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=admin@biospex.test
MAIL_FROM_NAME="${APP_NAME}"

# AWS (S3, SQS, Lambda, Step Functions)
# Local only; the servers use their instance role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
AWS_BUCKET=

# Zooniverse
ZOONIVERSE_ENABLED=false
ZOONIVERSE_PANOPTES_CLIENT_ID=
ZOONIVERSE_PANOPTES_CLIENT_SECRET=
ZOONIVERSE_PUSHER_ID=
# Supervisor program for the Panoptes listener: prod-panoptes-pusher or dev-panoptes-pusher
PANOPTES_LISTENER=dev-panoptes-pusher
PANOPTES_LISTENER_ENABLED=false

# GeoLocate
GEOLOCATE_ENABLED=false
GEOLOCATE_TOKEN=

# OCR and Darwin Core imports
OCR_ENABLED=true
DWC_FILE_SIZE_THRESHOLD_MB=30
DWC_ROW_COUNT_THRESHOLD=25000

# Translation.io
TRANSLATIONIO_KEY=
